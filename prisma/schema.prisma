generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. GESTÃO DE TENANTS (EXPERTS) E USUÁRIOS
// -------------------------------------------------------------
model User {
  id           String             @id @default(cuid())
  name         String
  email        String             @unique
  passwordHash String
  role         String             @default("OPERATOR") // ADMIN, MANAGER, EXPERT, OPERATOR
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  memberships  TenantMembership[]
  auditLogs    AuditLog[]
}

model Tenant {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  description        String?
  emailSender        String?            @default("contato@expertlaunch.com.br")
  whatsappNumber     String?
  hotmartHottok      String?            // Token secreto Hotmart do expert
  hotmartAccountId   String?
  status             String             @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  memberships        TenantMembership[]
  contacts           Contact[]
  tags               Tag[]
  automations        Automation[]
  scheduledJobs      ScheduledJob[]
  messageLogs        MessageLog[]
  webhookLogs        HotmartWebhookLog[]
  productRules       HotmartProductRule[]
  campaigns          Campaign[]
  auditLogs          AuditLog[]
  whatsappInstances  WhatsappInstance[]
  emailSettings      EmailSettings?
  emailLogs          EmailLog[]
  emailQueue         EmailQueue[]
  emailTemplates     EmailTemplate[]
  checkoutIntegrations  CheckoutIntegration[]
  checkoutWebhookEvents CheckoutWebhookEvent[]
  checkoutProducts      CheckoutProduct[]
  formIntegrations      FormIntegration[]
  formWebhookEvents     FormWebhookEvent[]
}

model TenantMembership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      String   @default("OPERATOR") // MANAGER, EXPERT, OPERATOR
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

// -------------------------------------------------------------
// 2. CRM, CONTATOS E SEGMENTAÇÃO
// -------------------------------------------------------------
model Contact {
  id             String          @id @default(cuid())
  tenantId       String
  name           String
  email          String
  phone          String?         // Formato internacional +55...
  status         String          @default("ACTIVE") // ACTIVE, UNSUBSCRIBED, BOUNCED
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  customFields   String?         // JSON com dados adicionais
  consentGiven   Boolean         @default(true) // LGPD
  consentDate    DateTime?       @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tags           ContactTag[]
  enrollments    AutomationEnrollment[]
  stepLogs       AutomationStepLog[]
  scheduledJobs  ScheduledJob[]
  messageLogs    MessageLog[]

  @@unique([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, status])
}

model Tag {
  id              String           @id @default(cuid())
  tenantId        String
  name            String
  color           String           @default("#6366f1")
  description     String?
  createdAt       DateTime         @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts            ContactTag[]
  integrationTags     IntegrationTag[]
  formIntegrationTags FormIntegrationTag[]

  @@unique([tenantId, name])
}

model ContactTag {
  id        String   @id @default(cuid())
  contactId String
  tagId     String
  addedAt   DateTime @default(now())

  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
}

// -------------------------------------------------------------
// 3. EDITOR VISUAL E MOTOR DE AUTOMAÇÃO
// -------------------------------------------------------------
model Automation {
  id          String                 @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      String                 @default("DRAFT") // DRAFT, ACTIVE, PAUSED
  triggerType String                 @default("TAG_ADDED") // CONTACT_CREATED, TAG_ADDED, HOTMART_EVENT, WEBHOOK, MANUAL
  triggerConfig String?              // JSON com detalhes do gatilho
  nodes       String                 @default("[]") // JSON do React Flow (nós, coordenadas, configurações)
  edges       String                 @default("[]") // JSON do React Flow (conexões)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments AutomationEnrollment[]
  scheduledJobs ScheduledJob[]
}

model AutomationEnrollment {
  id             String              @id @default(cuid())
  automationId   String
  contactId      String
  currentNodeId  String?
  status         String              @default("ACTIVE") // ACTIVE, WAITING, COMPLETED, CANCELLED, FAILED
  enteredAt      DateTime            @default(now())
  completedAt    DateTime?
  metadata       String?             // JSON com variáveis de execução

  automation     Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contact        Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stepLogs       AutomationStepLog[]
  scheduledJobs  ScheduledJob[]

  @@index([automationId, status])
  @@index([contactId, status])
}

model AutomationStepLog {
  id           String                @id @default(cuid())
  enrollmentId String
  contactId    String
  nodeId       String
  nodeType     String                // trigger, action, condition, delay
  action       String                // SEND_EMAIL, SEND_WHATSAPP, ADD_TAG, WAIT_DELAY, CHECK_CONDITION, etc.
  status       String                @default("SUCCESS") // SUCCESS, SKIPPED, FAILED
  details      String?               // JSON com detalhes
  executedAt   DateTime              @default(now())

  enrollment   AutomationEnrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  contact      Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([contactId])
}

model ScheduledJob {
  id              String               @id @default(cuid())
  tenantId        String
  enrollmentId    String
  contactId       String
  automationId    String
  targetNodeId    String
  executeAt       DateTime
  status          String               @default("PENDING") // PENDING, PROCESSING, COMPLETED, CANCELLED, FAILED
  cancelCondition String?              // Ex: PURCHASE_APPROVED, TAG_ADDED:Cliente, etc.
  attempts        Int                  @default(0)
  maxAttempts     Int                  @default(3)
  lastError       String?
  createdAt       DateTime             @default(now())

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment      AutomationEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  contact         Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  automation      Automation           @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([status, executeAt])
  @@index([tenantId, contactId, status])
}

// -------------------------------------------------------------
// 4. MENSAGENS (WHATSAPP E E-MAIL)
// -------------------------------------------------------------
model MessageLog {
  id                String    @id @default(cuid())
  tenantId          String
  contactId         String
  channel           String    // WHATSAPP, EMAIL
  provider          String    // SIMULATED, META_CLOUD, RESEND, BREVO
  recipient         String
  subject           String?
  content           String
  templateName      String?
  status            String    @default("SENT") // QUEUED, SENT, DELIVERED, READ, FAILED, BOUNCED
  externalMessageId String?
  costEstimate      Float?    @default(0.0)
  error             String?
  sentAt            DateTime  @default(now())
  deliveredAt       DateTime?
  readAt            DateTime?

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact           Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, channel, status])
  @@index([contactId])
}

// -------------------------------------------------------------
// 5. INTEGRAÇÃO HOTMART E REGRAS DE PRODUTO
// -------------------------------------------------------------
model HotmartWebhookLog {
  id             String    @id @default(cuid())
  tenantId       String
  eventType      String    // PURCHASE_APPROVED, PURCHASE_WAITING_PAYMENT, PURCHASE_CANCELED, PURCHASE_REFUNDED, etc.
  transactionId  String?
  buyerEmail     String
  buyerName      String?
  buyerPhone     String?
  productName    String?
  productId      String?
  paymentType    String?   // PIX, BILLET, CREDIT_CARD
  priceValue     Float?
  idempotencyKey String    @unique // Garante que webhooks duplicados da Hotmart sejam descartados com segurança
  processed      Boolean   @default(false)
  payload        String    // JSON original completo recebido
  receivedAt     DateTime  @default(now())

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, buyerEmail])
  @@index([transactionId])
}

model HotmartProductRule {
  id                String   @id @default(cuid())
  tenantId          String
  productId         String
  productName       String
  eventType         String   // PURCHASE_APPROVED, PURCHASE_WAITING_PAYMENT, etc.
  addTags           String   @default("[]") // JSON Array com tags a adicionar
  removeTags        String   @default("[]") // JSON Array com tags a remover
  startAutomationId String?  // ID do fluxo a iniciar
  cancelAutomations String   @default("[]") // JSON Array com IDs de fluxos a cancelar imediatamente
  createdAt         DateTime @default(now())

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 6. CAMPANHAS E MODELOS DE LANÇAMENTO
// -------------------------------------------------------------
model Campaign {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  modelType   String    // SEMENTE, CLASSICO, PERPETUO, WEBINAR, RECUPERACAO_PIX, POS_VENDA
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("ACTIVE") // ACTIVE, DRAFT, FINISHED
  goalLeads   Int?      @default(1000)
  notes       String?
  createdAt   DateTime  @default(now())

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 7. TRILHA DE AUDITORIA E LGPD
// -------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String   // CONTACT_DELETED, EXPORT_CSV, WEBHOOK_PROCESSED, AUTOMATION_TRIGGERED, etc.
  resource   String
  details    String?  // JSON
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

// -------------------------------------------------------------
// 8. MULTI-TENANT EVOLUTION API (INSTÂNCIAS DE WHATSAPP COMPARTILHADAS ENTRE EXPERTS)
// -------------------------------------------------------------
model WhatsappInstance {
  id              String    @id @default(cuid())
  tenantId        String?
  name            String?   // Apelido / Nome amigável (ex: "Denis Dominique - Principal", "Suporte Vendas")
  instanceName    String    @unique
  instanceToken   String
  phone           String?
  profileName     String?
  profilePicUrl   String?
  status          String    @default("DISCONNECTED") // CONNECTED, DISCONNECTED, CONNECTING
  qrcode          String?   // Base64 para exibição única no frontend
  isDefault       Boolean   @default(false)
  lastConnectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  @@index([tenantId])
}

// -------------------------------------------------------------
// 9. MULTI-TENANT EMAIL SERVICE (CONFIGURAÇÕES E LOGS POR EXPERT)
// -------------------------------------------------------------
model EmailSettings {
  id            String    @id @default(cuid())
  tenantId      String    @unique
  provider      String    @default("SMTP") // SMTP, SES, RESEND, MAILGUN, BREVO
  smtpHost      String
  smtpPort      Int       @default(587)
  smtpSecure    Boolean   @default(false)
  smtpUsername  String
  smtpPassword  String    // Criptografada com AES-256
  fromName      String
  fromEmail     String
  replyTo       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id           String    @id @default(cuid())
  tenantId     String
  to           String
  subject      String
  status       String    @default("SENT") // SENT, FAILED
  provider     String    @default("SMTP")
  errorMessage String?
  messageId    String?
  metadata     String?   // JSON com payload / resposta
  createdAt    DateTime  @default(now())

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

// -------------------------------------------------------------
// 10. FILA DE ENVIO DE E-MAILS (EMAIL QUEUE & RATE LIMITING)
// -------------------------------------------------------------
model EmailQueue {
  id           String    @id @default(cuid())
  tenantId     String
  toEmail      String    @map("to_email")
  subject      String
  htmlContent  String    @map("html_content")
  status       String    @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3) @map("max_attempts")
  errorMessage String?   @map("error_message")
  scheduledAt  DateTime  @default(now()) @map("scheduled_at")
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("email_queue")
  @@index([tenantId, status])
  @@index([status, scheduledAt])
}

// -------------------------------------------------------------
// 10.1. MODELOS DE E-MAIL (EMAIL BUILDER & TEMPLATES)
// -------------------------------------------------------------
model EmailTemplate {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  name          String
  subject       String?
  contentJson   String    @map("content_json") // JSON dos blocos e estilos
  generatedHtml String    @map("generated_html") // HTML responsivo final
  category      String?   @default("custom") // welcome, purchase, recovery, promo, custom
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("email_templates")
  @@index([tenantId])
}

// -------------------------------------------------------------
// 11. PLATAFORMAS DE CHECKOUT E INTEGRAÇÕES MULTI-PLATAFORMA
// -------------------------------------------------------------
model CheckoutIntegration {
  id              String                 @id @default(cuid())
  tenantId        String                 @map("tenant_id")
  platform        String                 // HOTMART, KIWIFY, CAKTO, MONETIZZE, PERFECTPAY, EDUZZ, BRAIP, CUSTOM
  name            String
  status          String                 @default("ACTIVE") // ACTIVE, INACTIVE
  secretKey       String?                @map("secret_key")
  webhookUrl      String?                @map("webhook_url")
  allowedEvents   String                 @default("[\"purchase_approved\",\"purchase_waiting_payment\",\"billet_printed\",\"pix_generated\",\"cart_abandoned\",\"canceled\",\"refunded\",\"chargeback\"]") @map("allowed_events")
  productName     String?                @map("product_name")
  productId       String?                @map("product_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookEvents   CheckoutWebhookEvent[]
  products        CheckoutProduct[]
  integrationTags IntegrationTag[]

  @@map("integrations")
  @@index([tenantId, platform])
}

model IntegrationTag {
  id            String              @id @default(cuid())
  integrationId String              @map("integration_id")
  tagId         String              @map("tag_id")
  createdAt     DateTime            @default(now()) @map("created_at")

  integration   CheckoutIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  tag           Tag                 @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([integrationId, tagId])
  @@map("integration_tags")
  @@index([integrationId])
  @@index([tagId])
}

model CheckoutWebhookEvent {
  id             String               @id @default(cuid())
  tenantId       String               @map("tenant_id")
  integrationId  String?              @map("integration_id")
  platform       String
  eventType      String               @map("event_type")
  payload        String               // JSON string
  status         String               @default("PROCESSED") // PROCESSED, FAILED, IGNORED
  customerEmail  String?              @map("customer_email")
  customerName   String?              @map("customer_name")
  customerPhone  String?              @map("customer_phone")
  productName    String?              @map("product_name")
  priceValue     Float?               @map("price_value")
  paymentType    String?              @map("payment_type")
  transactionId  String?              @map("transaction_id")
  errorMessage   String?              @map("error_message")
  createdAt      DateTime             @default(now()) @map("created_at")

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration    CheckoutIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@map("webhook_events")
  @@index([tenantId, createdAt])
  @@index([integrationId, status])
  @@index([transactionId])
}

model CheckoutProduct {
  id            String              @id @default(cuid())
  tenantId      String              @map("tenant_id")
  integrationId String              @map("integration_id")
  externalId    String?             @map("external_id")
  name          String
  createdAt     DateTime            @default(now()) @map("created_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration   CheckoutIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("products")
  @@index([tenantId, integrationId])
}

// -------------------------------------------------------------
// 12. INTEGRAÇÃO WORDPRESS / ELEMENTOR E FORMULÁRIOS DE CAPTAÇÃO
// -------------------------------------------------------------
model FormIntegration {
  id                 String               @id @default(cuid())
  tenantId           String               @map("tenant_id")
  name               String
  platform           String               @default("ELEMENTOR") // ELEMENTOR, WORDPRESS, CONTACT_FORM_7, WPFORMS, CUSTOM
  status             String               @default("ACTIVE") // ACTIVE, INACTIVE
  webhookUrl         String?              @map("webhook_url")
  secretKey          String?              @map("secret_key")
  allowReentry       String               @default("ALWAYS") @map("allow_reentry") // ALWAYS, NEVER
  targetAutomationId String?              @map("target_automation_id")
  fieldMapping       String?              @map("field_mapping") // JSON string
  samplePayload      String?              @map("sample_payload") // JSON string
  totalEvents        Int                  @default(0) @map("total_events")
  newContacts        Int                  @default(0) @map("new_contacts")
  updatedContacts    Int                  @default(0) @map("updated_contacts")
  lastEventAt        DateTime?            @map("last_event_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integrationTags    FormIntegrationTag[]
  events             FormWebhookEvent[]

  @@map("form_integrations")
  @@index([tenantId])
}

model FormIntegrationTag {
  id            String          @id @default(cuid())
  integrationId String          @map("integration_id")
  tagId         String          @map("tag_id")
  createdAt     DateTime        @default(now()) @map("created_at")

  integration   FormIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  tag           Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([integrationId, tagId])
  @@map("form_integration_tags")
  @@index([integrationId])
  @@index([tagId])
}

model FormWebhookEvent {
  id                   String           @id @default(cuid())
  tenantId             String           @map("tenant_id")
  integrationId        String?          @map("integration_id")
  status               String           @default("PROCESSED") // PROCESSED, FAILED, SIMULATED
  payload              String           // JSON string
  parsedData           String?          @map("parsed_data") // JSON string
  contactId            String?          @map("contact_id")
  contactEmail         String?          @map("contact_email")
  contactName          String?          @map("contact_name")
  contactPhone         String?          @map("contact_phone")
  tagsApplied          String?          @map("tags_applied") // JSON array string
  automationsTriggered String?          @map("automations_triggered") // JSON array string
  errorMessage         String?          @map("error_message")
  ipAddress            String?          @map("ip_address")
  userAgent            String?          @map("user_agent")
  createdAt            DateTime         @default(now()) @map("created_at")

  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration          FormIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@map("form_webhook_events")
  @@index([tenantId, createdAt])
  @@index([integrationId, status])
}
